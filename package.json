{
  "name": "@local/dsh-telegram-ru",
  "version": "0.3.0",
  "description": "Control DeepSeek Harness via Telegram in English and Russian: projects, tasks and results. / Управление DeepSeek Harness через Telegram на английском и русском: проекты, задачи и результаты.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "telegram",
    "chatbot",
    "plugin"
  ],
  "homepage": "https://github.com/seoeaa/dsh-telegram-ru#readme",
  "bugs": {
    "url": "https://github.com/seoeaa/dsh-telegram-ru/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seoeaa/dsh-telegram-ru.git"
  },
  "author": "Gum97",
  "engines": {
    "node": ">=22.19.0"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./markdown": "./lib/markdown.js",
    "./api": "./lib/api.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "LICENSE",
    "cordis.patch.yml",
    "README.md",
    "README.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-remotes"
      ],
      "platform": "web"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@deepseek-ai/schemastery": "*",
    "undici": "8.10.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  },
  "contributors": [
    "seoeaa"
  ]
}
